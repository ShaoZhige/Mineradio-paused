{
  "name": "mineradio",
  "productName": "Mineradio",
  "version": "2.8.1",
  "description": "沉浸式音乐播放器",
  "author": "Mineradio",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-ci-tests.js",
    "test:ci": "node scripts/run-ci-tests.js",
    "test:electron": "node scripts/run-electron-tests.js",
    "test:custom-source-host": "electron tests/custom-source-electron-smoke.js",
    "check:quick": "node scripts/quick-check.js",
    "check:budget": "node scripts/check-resource-budget.js",
    "check:all": "node scripts/run-ci-tests.js && node scripts/quick-check.js && node scripts/check-resource-budget.js",
    "check:package": "node scripts/verify-package.js",
    "audit:prod": "node scripts/audit-prod.js",
    "archive:release": "node scripts/archive-release-build.mjs",
    "build:apple-music": "node build/build-apple-music.js",
    "prebuild:win": "npm run build:apple-music",
    "prebuild:win:dir": "npm run build:apple-music",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir",
    "qa:lyrics": "node qa/lyrics-classic.js",
    "qa:desktop": "node qa/desktop-mode.js"
  },
  "build": {
    "appId": "com.mineradio.desktop",
    "productName": "Mineradio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "npmRebuild": false,
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "extraFiles": [
      {
        "from": "build/visual-elements/Mineradio.VisualElementsManifest.xml",
        "to": "Mineradio.VisualElementsManifest.xml"
      },
      {
        "from": "build/visual-elements/VisualElements",
        "to": "VisualElements"
      }
    ],
    "extraResources": [
      {
        "from": "build/apple-music-native/windows/bin/Release/net48",
        "to": "apple-music/windows",
        "filter": [
          "MineradioAppleMusicCompanion.exe",
          "MineradioAppleMusicCompanion.exe.config",
          "Microsoft.Web.WebView2.Core.dll",
          "Microsoft.Web.WebView2.WinForms.dll",
          "WebView2Loader.dll",
          "runtimes/**/*"
        ]
      }
    ],
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "!build/.dotnet/**",
      "!build/apple-music-native/**",
      "!build/dotnet-install.ps1",
      "!build/dotnet-install.log",
      "cuefield/**/*",
      "server/**/*",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "!public/vendor/jieba-dict.txt",
      "public/index.html",
      "!node_modules/NeteaseCloudMusicApi/public/**",
      "!node_modules/NeteaseCloudMusicApi/data/**",
      "!node_modules/gsap/**",
      "!node_modules/xml2js/lib/xml2js.bc.js",
      "!node_modules/node-hid/prebuilds/HID-linux*/**",
      "!node_modules/node-hid/prebuilds/HID-darwin*/**",
      "!node_modules/node-hid/prebuilds/HID_hidraw*/**",
      "!node_modules/node-hid/hidapi/**",
      "!node_modules/node-hid/src/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts"
    ],
    "asar": true,
    "asarUnpack": [
      "build/**/*",
      "desktop/halo-hid-server.js",
      "node_modules/node-hid/**",
      "node_modules/pkg-prebuilds/**"
    ],
    "compression": "maximum",
    "win": {
      "executableName": "Mineradio",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "electronLanguages": [
        "zh-CN",
        "en-US",
        "en-GB",
        "ja",
        "ru"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Mineradio-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ShaoZhige",
        "repo": "Mineradio-paused"
      }
    ]
  },
  "mineradio": {
    "update": {
      "provider": "github",
      "owner": "ShaoZhige",
      "repo": "Mineradio-paused",
      "preview": false,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "11.16.1",
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-hid": "^3.4.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.20.0",
    "basic-ftp": "6.2.2",
    "body-parser": "1.20.9",
    "follow-redirects": "1.16.2",
    "ip-address": "10.7.4",
    "music-metadata": "11.16.1",
    "node-forge": "1.4.2",
    "qs": "6.17.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
